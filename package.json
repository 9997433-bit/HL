{
  "name": "hongen-edu-apps",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "洪恩式识字与数学教育应用 monorepo",
  "workspaces": [
    "apps/literacy-app",
    "apps/math-app"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "bash scripts/build-all.sh",
    "build:all": "bash scripts/build-all.sh",
    "test": "npm run test:feedback && npm run test:mascot && npm run test:literacy && npm run test:math",
    "fetch:openmoji": "node scripts/fetch-openmoji.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:tokens:wiring": "node scripts/check-tokens.mjs --wiring-only",
    "check:round4": "node scripts/check-round4.mjs",
    "check:round5": "node scripts/check-round5.mjs",
    "check:round5b": "node scripts/check-round5b.mjs",
    "check:round6": "node scripts/check-round6.mjs",
    "check:round7": "node scripts/check-round7.mjs",
    "check:round8": "node scripts/check-round8.mjs",
    "check:round9": "node scripts/check-round9.mjs",
    "check:round10": "node scripts/check-round10.mjs",
    "check:round11": "node scripts/check-round11.mjs",
    "check:round12": "node scripts/check-round12.mjs",
    "check:round13": "node scripts/check-round13.mjs",
    "check:round14": "node scripts/check-round14.mjs",
    "check:round15": "node scripts/check-round15.mjs",
    "check:round16": "node scripts/check-round16.mjs",
    "check:round17": "node scripts/check-round17.mjs",
    "check:round18": "node scripts/check-round18.mjs",
    "check:round19": "node scripts/check-round19.mjs",
    "android:sim": "node scripts/android-sim.mjs",
    "android:device:qa": "node scripts/android-device-matrix.mjs",
    "check:android": "node scripts/check-android.mjs",
    "check:map-narrative": "node scripts/check-map-narrative.mjs",
    "gen:icons": "node scripts/gen-pwa-icons.mjs",
    "import:book": "node scripts/import-book-submission.mjs",
    "check:submissions": "node scripts/import-book-submission.mjs --check-all",
    "sync:android": "bash scripts/sync-android.sh all",
    "sync:android:literacy": "bash scripts/sync-android.sh literacy",
    "sync:android:math": "bash scripts/sync-android.sh math",
    "test:a11y": "node scripts/axe-states.mjs",
    "test:acceptance": "bash scripts/acceptance.sh",
    "test:lighthouse:ci": "ACCEPTANCE_MIN_LH_PERFORMANCE=0.95 node scripts/lighthouse-ci.mjs",
    "test:lighthouse:desktop": "ACCEPTANCE_LH_PROFILE=desktop ACCEPTANCE_MIN_LH_PERFORMANCE=0.95 node scripts/lighthouse-ci.mjs",
    "test:feedback": "node scripts/test-feedback.mjs",
    "test:mascot": "node scripts/test-mascot-weekly.mjs",
    "test:literacy": "bash scripts/test-literacy.sh",
    "test:math": "bash scripts/test-math.sh",
    "test:round16:smoke": "node --test scripts/test-round16-smoke.mjs",
    "test:round18:smoke": "npm run test:play:split --workspace=apps/literacy-app && npm run verify:wp-steps --workspace=apps/math-app",
    "walkthrough:shots": "node scripts/walkthrough-shots.mjs",
    "walkthrough:shots:r18": "node scripts/walkthrough-shots-r18.mjs",
    "test:offline": "bash scripts/offline-smoke.sh",
    "test:round3": "npm test && npm run test:offline && npm run test:acceptance",
    "test:c6:chrome": "node scripts/browser-matrix-chrome.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "ajv": "^8.17.1",
    "axe-core": "^4.13.0",
    "lighthouse": "12.8.2",
    "puppeteer-core": "^25.9.0"
  }
}
